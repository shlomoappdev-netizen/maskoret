# Personal files that must never reach a repository
*.xlsx
*.xls
להפצה/
ארכיון/
.version-check

# macOS / Xcode
.DS_Store
xcuserdata/
DerivedData/
*.xcuserstate

# Flutter (flutter_app/ has its own .gitignore too)
flutter_app/build/
flutter_app/.dart_tool/

# Secrets kept by hand (Google client secret, a copy of the Android signing key) — never in git
חשוב/
*.jks
client_secret_*.json

# Support agent dependencies
tools/support-agent/node_modules/
